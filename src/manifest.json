{
  "manifest_version": 3,
  "name": "Gemini Canvas Markdown Copy",
  "version": "2.2.4",
  "description": "Gemini의 응답들을 Markdown으로 복사하기 위한 도구. 선택해서 복사하기는 ChatGPT도 지원함.",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_title": "출처 복사: 출처 복사 안함",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "permissions": ["clipboardWrite", "contextMenus", "storage"],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://notebooklm.google.com/*",
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://gemini.google.com/*", "https://chatgpt.com/*"],
      "js": ["context-menu-handler.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://notebook.google.com/*"],
      "css": ["content.css"],
      "js": ["notebooklm-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://notebook.google.com/*"],
      "js": ["notebooklm-context-menu-handler.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["chatGPT-fix-copyButton.js", "chatgpt-content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
